{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebb",
  "version": "0.2.0",
  "identifier": "dev.ebb.app",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ebb",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Disk space, safe cleanups and AI storage",
    "longDescription": "Ebb finds what fills your disk, plans safe cleanups you can undo, and lets your AI assistants help over MCP. Open source, no telemetry.",
    "copyright": "Copyright 2026 Ebb contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "externalBin": [
      "binaries/ebb"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}